function S.Stop()
    if not S.running then return end
    S.running = false
    S.silent = false
    S.esp = false
    S.noRecoil = false
    S.target = nil
    S.visualShot = nil
    clearBoxes()
    -- Restore the original module methods only if still owned by us.
    for _, proto in ipairs(recoilPrototypes) do
        local item = recoilOriginals[proto]
        if item then
            pcall(function()
                if proto.shot == item.replacementShot then
                    proto.shot = item.shot
                end
                if proto.step == item.replacementStep then
                    proto.step = item.step
                end
            end)
        end
    end
    if S.tracerReady and Tracers and Tracers.fire==tracerWrapper then
        pcall(function() Tracers.fire=oldTracerFire end)
    end
    for _,c in ipairs(S.connections) do pcall(function() c:Disconnect() end) end
    table.clear(S.connections)
    ESPGui:Destroy()
    FOVGui:Destroy()
    GUI:Destroy()
    if ENV.VoxelSilentAim==S then ENV.VoxelSilentAim=nil end
    print("[RAI HUB V10] Unloaded")
end
bind(Close.MouseButton1Click,S.Stop)
bind(UIS.InputBegan,function(input,processed)
    if processed or not S.running then return end
    if input.KeyCode==Enum.KeyCode.LeftControl
        or input.KeyCode==Enum.KeyCode.RightControl then
        GUI.Enabled=not GUI.Enabled
    end
end)
local dragging,dragStart,startPos=false,nil,nil
bind(Topbar.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
bind(UIS.InputChanged,function(input)
    if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=input.Position-dragStart
        Main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)
bind(UIS.InputEnded,function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
end)

selectTab("Combat")
Main.BackgroundTransparency=.2
tween(Main,.3,{BackgroundTransparency=0})
