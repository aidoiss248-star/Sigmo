bind(RunService.RenderStepped,function(dt)
    if not S.running then return end
    local a=1-math.exp(-dt*15)
    displayedFov+=(CFG.fov-displayedFov)*a
    Circle.Size=UDim2.fromOffset(displayedFov*2,displayedFov*2)
    Circle.Visible=S.silent and S.showCircle
    for _,v in ipairs(sliders) do
        v.display+=(v.ratio-v.display)*a
        v.fill.Size=UDim2.fromScale(v.display,1)
        v.knob.Position=UDim2.fromScale(v.display,.5)
    end
    updateWindowScale()
    if snowEnabled then
        local time=os.clock()
        for _,f in ipairs(Snowflakes) do
            f.y += f.speed*dt
            f.x += f.drift*dt
            if f.y>525 then
                f.y=-f.sz-math.random(0,25)
                f.x=math.random(0,865)
            end
            if f.x < -7 then f.x=870 end
            if f.x > 870 then f.x=-7 end
            local wobble=math.sin(time*1.2+f.phase)*1.3
            f.object.Position=UDim2.fromOffset(f.x+wobble,f.y)
        end
    end
end)
