    valueLabel.TextXAlignment=Enum.TextXAlignment.Right
    local track=make("Frame",{Parent=row,Position=UDim2.fromOffset(9,43),
        Size=UDim2.new(1,-18,0,4),BackgroundColor3=Color3.fromRGB(64,67,73),BorderSizePixel=0})
    radius(track,10)
    local ratio=(value-min)/(max-min)
    local fill=make("Frame",{Parent=track,Size=UDim2.fromScale(ratio,1),
        BackgroundColor3=T.blue,BorderSizePixel=0})
    radius(fill,10)
    local knob=make("Frame",{Parent=track,AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.fromScale(ratio,.5),Size=UDim2.fromOffset(13,13),
        BackgroundColor3=T.text,BorderSizePixel=0})
    radius(knob,10)
    local hitbox=make("Frame",{Parent=row,Position=UDim2.fromOffset(0,28),
        Size=UDim2.new(1,0,0,35),BackgroundTransparency=1,Active=true})
    local state={ratio=ratio,display=ratio,fill=fill,knob=knob}
    table.insert(sliders,state)
    local drag=false
    local function move(x)
        local width=track.AbsoluteSize.X
        if width<1 then return end
        local alpha=math.clamp((x-track.AbsolutePosition.X)/width,0,1)
        local v=math.floor(min+(max-min)*alpha+.5)
        state.ratio=(v-min)/(max-min)
        valueLabel.Text=tostring(v)
        if fn then fn(v) end
    end
    bind(hitbox.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true move(input.Position.X)
        end
    end)
    bind(UIS.InputChanged,function(input)
        if drag and input.UserInputType==Enum.UserInputType.MouseMovement then
            move(input.Position.X)
        end
    end)
    bind(UIS.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
end

