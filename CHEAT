-- =====================================
-- NO RECOIL: GAME'S GUNRECOIL CLASS
-- =====================================
-- The rifle controller calls GunRecoil.new(weaponName) once, then
-- uses recoilInstance:shot() and recoilInstance:step(dt).
-- Intercepting these methods preserves FireServer, ammo, sound,
-- and ordinary gun firing behavior. This only affects CLIENT recoil.
local recoilOriginals = {}
local recoilPrototypes = {}

local function patchRecoilPrototype(proto)
    if type(proto) ~= "table" or recoilOriginals[proto] then return false end
    local originalShot = rawget(proto, "shot")
    local originalStep = rawget(proto, "step")
    if type(originalShot) ~= "function" or type(originalStep) ~= "function" then
        return false
    end

    local replacementShot = function(self, ...)
        if S.running and S.noRecoil then
            if type(self) == "table" then
                self.pitch = 0
                self.yaw = 0
            end
            return nil
        end
        return originalShot(self, ...)
    end

    local replacementStep = function(self, ...)
        if S.running and S.noRecoil then
            if type(self) == "table" then
                self.pitch = 0
                self.yaw = 0
            end
            return 0, 0, 0
        end
        return originalStep(self, ...)
    end

    local ok = pcall(function()
        proto.shot = replacementShot
        proto.step = replacementStep
    end)
    if ok and proto.shot == replacementShot and proto.step == replacementStep then
        recoilOriginals[proto] = {
            shot = originalShot,
            step = originalStep,
            replacementShot = replacementShot,
            replacementStep = replacementStep,
        }
        table.insert(recoilPrototypes, proto)
        return true
    end
    return false
end

pcall(function()
    local module = Voxel:FindFirstChild("GunRecoil")
    if not module then return end
    local gunRecoil = require(module)
    if type(gunRecoil) ~= "table" then return end

    -- Most Luau class modules expose :shot and :step on the class table.
    if patchRecoilPrototype(gunRecoil) then
        S.recoilReady = true
        S.recoilMode = "GUN RECOIL"
        return
    end

    -- Some modules store the methods in a distinct metatable __index.
    -- Probe without changing the shot logic or assuming a live weapon.
    if type(gunRecoil.new) == "function" then
        local ok, probe = pcall(gunRecoil.new, "AssaultRifle")
        if ok and type(probe) == "table" then
            local mt = getmetatable(probe)
            if type(mt) == "table" and type(mt.__index) == "table" then
                if patchRecoilPrototype(mt.__index) then
                    S.recoilReady = true
                    S.recoilMode = "GUN RECOIL"
                end
            end
        end
    end
end)


local function alive(model)
    if not model or model:GetAttribute("Alive") == false or model:GetAttribute("Protected") == true then
        return false
    end
    local h = model:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

local function enemy(pl)
    if pl == LP then return false end
    if LP.Team and pl.Team and not LP.Neutral and not pl.Neutral then
        return pl.Team ~= LP.Team
    end
    return true
end

local function visibleESP(pl)
    return pl ~= LP and (CFG.espTeam or enemy(pl))
end

local function parts(model)
    local head = model:FindFirstChild("Head")
    local torso = model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
    return head, torso
end

-- Lightweight motion history, keyed by actual root parts. The values come
-- from replicated physics and should not be treated as exact future motion.
local motionHistory = setmetatable({}, {__mode = "k"})
local function updateMotion(root)
    if not root then return Vector3.zero end
    local now = os.clock()
    local velocity = root.AssemblyLinearVelocity
    local record = motionHistory[root]
    if not record then
        record = {velocity = velocity, t = now, acceleration = Vector3.zero}
        motionHistory[root] = record
        return Vector3.zero
    end
    local dt = now - record.t
    if dt >= .025 then
        -- Reject large replication discontinuities instead of making
        -- an unstable lead that can overshoot a suddenly turning player.
        if dt < .4 then
            local a = (velocity - record.velocity) / dt
            a = Vector3.new(a.X, 0, a.Z)
            local limit = 120
            if a.Magnitude > limit then a = a.Unit * limit end
            record.acceleration = record.acceleration:Lerp(a, .23)
        else
            record.acceleration = Vector3.zero
        end
        record.velocity, record.t = velocity, now
    end
    return record.acceleration
end

-- Target acquisition works in SCREEN PIXELS, irrespective of world distance.
-- Never calls a distance < 500 condition or hooks workspace:Raycast.
local function pick()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = cam.ViewportSize * 0.5
    local origin = cam.CFrame.Position
    local bestDist, best = CFG.fov, nil
    local exclude = {cam}
    if LP.Character then table.insert(exclude, LP.Character) end
    for _, n in ipairs({"VoxelChips", "VoxelLoose", "VoxelTracers", "VoxelGrenades", "VoxelFireFX"}) do
        local found = workspace:FindFirstChild(n)
        if found then table.insert(exclude, found) end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local function consider(model, name)
        if not alive(model) then return end
        local head, body = parts(model)
        local focus = body or head
        if not focus then return end
        local screen, on = cam:WorldToViewportPoint(focus.Position)
        if not on or screen.Z <= 0 then return end
        local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
        if d >= bestDist then return end
        if CFG.wallcheck and not CFG.wallbang then
            local filter = table.clone(exclude)
            table.insert(filter, model)
            params.FilterDescendantsInstances = filter
            if workspace:Raycast(origin, focus.Position - origin, params) then return end
        end
        local root = model:FindFirstChild("HumanoidRootPart")
        bestDist = d
        best = {
            name = name,
            model = model,
            root = root,
            headPart = head,
            bodyPart = body,
            head = head and head.Position or nil,
            body = body and body.Position or nil,
            velocity = root and root.AssemblyLinearVelocity or Vector3.zero,
            acceleration = root and updateMotion(root) or Vector3.zero,
            distance = (focus.Position - origin).Magnitude,
        }
    end

    if CFG.players then
        for _, pl in ipairs(Players:GetPlayers()) do
            if enemy(pl) and pl.Character then consider(pl.Character, pl.Name) end
        end
    end
    if CFG.bots then
        local rigs = workspace:FindFirstChild("BotRigs")
        if rigs then
            local myTeam = LP.Team and LP.Team.Name or nil
            for _, model in ipairs(rigs:GetChildren()) do
                if not myTeam or tostring(model:GetAttribute("Team")) ~= myTeam then
                    consider(model, model.Name)
                end
            end
        end
    end
    return best
end

local refreshClock, pingClock = 0, 0
bind(RunService.Heartbeat, function(dt)
    if not S.running then return end
    refreshClock += dt
    pingClock += dt
    if pingClock >= 1 then
        pingClock = 0
        local ok, ping = pcall(function() return LP:GetNetworkPing() end)
        if ok and type(ping) == "number" then
            S.networkPing = math.clamp(ping, 0, 0.5)
        end
    end
    if refreshClock < 0.045 then return end
    refreshClock = 0
    if not S.silent then
        S.target, S.targetName, S.targetDistance = nil, "NONE", 0
        return
    end
    local ok, target = pcall(pick)
    if ok and target then
        S.target = target
        S.targetName = target.name
        S.targetDistance = target.distance
        S.targetTime = os.clock()
    else
        S.target, S.targetName, S.targetDistance = nil, "NONE", 0
    end
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    S.velocityMultiplier = tool and tonumber(tool:GetAttribute("GsVelocity")) or 1
end)

-- Travel-time estimate with safe fallback. It does NOT extend server bullet lifetime.
local function flightTime(distance, speed, arc)
    speed = math.max(1, speed)
    local fallback = distance / speed
    if Ballistics and type(Ballistics.flightTime) == "function" then
        local ok, t = pcall(Ballistics.flightTime, distance, speed, arc)
        if ok and type(t) == "number" and t == t and t > 0 and t < math.huge then
            return math.clamp(t, 0, CFG.maxPredictionTime)
        end
    end
    return math.clamp(fallback, 0, CFG.maxPredictionTime)
end

-- Estimate the future point for a moving / jumping target.
-- The weapon remains server-controlled: this predicts where to aim;
-- it cannot extend server range or guarantee the shot will be accepted.
local function predictTargetPosition(model, root, humanoid, point, velocity, acceleration, seconds, groundCache)
    local t = math.clamp(seconds, 0, CFG.maxPredictionTime)
    local move = velocity * t

    if CFG.strafeLead then
        -- Short acceleration window: players do not keep accelerating
        -- for several seconds at the same rate while running.
        local aTime = math.min(t, .35)
        move += Vector3.new(acceleration.X, 0, acceleration.Z)
            * (.5 * aTime * aTime)
    end

    local aimAt = point + move
    local state = humanoid and humanoid:GetState()
    local inAir = humanoid and (
        humanoid.FloorMaterial == Enum.Material.Air
        or state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.FallingDown
    )

    if CFG.airLead and inAir then
        aimAt -= Vector3.new(0, .5 * workspace.Gravity * t * t, 0)

        -- Do not predict a jumping player thousands of studs underground.
        -- Estimate the first supporting surface immediately underneath.
        if root then
            if not groundCache.checked then
                groundCache.checked = true
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {model, LP.Character}
                params.IgnoreWater = true
                local floorHit = workspace:Raycast(
                    root.Position + Vector3.new(0, .1, 0),
                    Vector3.new(0, -130, 0), params)
                if floorHit and floorHit.Normal.Y > .55 then
                    local hip = tonumber(humanoid.HipHeight) or 2
                    groundCache.minimum = floorHit.Position.Y + hip
                        + root.Size.Y * .5 + (point.Y - root.Position.Y)
                end
            end
            if groundCache.minimum then
                aimAt = Vector3.new(aimAt.X,
                    math.max(aimAt.Y, groundCache.minimum), aimAt.Z)
            end
        end
    end
    return aimAt
end

local function rewrite(name, a, n)
    local muzzle = a[1]
    if typeof(muzzle) ~= "Vector3" or typeof(a[2]) ~= "Vector3" then return false end
    if math.random(100) > CFG.hitChance then return false end
    local target = S.target
    if not target or os.clock() - S.targetTime > .22 then return false end

    -- Fresh geometry at shot time rather than 45ms-old cached coordinates.
    local model = target.model
    if not model or not model.Parent or not alive(model) then return false end
    local head = target.headPart and target.headPart.Parent == model and target.headPart
        or model:FindFirstChild("Head")
    local body = target.bodyPart and target.bodyPart.Parent == model and target.bodyPart
        or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
    local root = target.root and target.root.Parent == model and target.root
        or model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local distance = root and (root.Position - muzzle).Magnitude or target.distance
    local far = distance >= CFG.farBodyDistance
    local headShot = math.random(100) <= CFG.headChance
    if CFG.autoBodyFar and far then headShot = false end
    local focus = headShot and (head or body) or (body or head)
    if not focus then return false end
    local currentPoint = focus.Position
    local velocity = root and root.AssemblyLinearVelocity or target.velocity
    local acceleration = root and motionHistory[root]
        and motionHistory[root].acceleration or target.acceleration or Vector3.zero

    local speed = Ballistics and tonumber(Ballistics.SPEED) or 1700
    local arc = nil
    if name == "FireSniper" then
        speed = (Ballistics and tonumber(Ballistics.RIFLE_SPEED) or 2150)
            * (S.velocityMultiplier or 1)
        arc = Ballistics and Ballistics.RIFLE_ARC or nil
    end
    speed = math.max(100, speed)

    local ping = S.networkPing * (CFG.pingFactor / 100)
    local point = currentPoint
    local travelTime = 0
    local groundCache = {checked = false}
    if CFG.longRangePrediction then
        -- Fixed-point intercept iteration: target movement changes distance,
        -- and distance changes bullet flight time in turn.
        for _ = 1, 7 do
            travelTime = flightTime((point - muzzle).Magnitude, speed, arc)
            local total = math.min(CFG.maxPredictionTime, travelTime + ping)
            point = predictTargetPosition(model, root, humanoid, currentPoint,
                velocity, acceleration, total, groundCache)
        end
    end
    S.lastFlightTime = travelTime
    S.lastLeadDistance = (point - currentPoint).Magnitude

    if not S.noRecoil then
        point += Vector3.new(math.random(-7, 7), math.random(-7, 7),
            math.random(-7, 7)) / 100
    end
    local delta = point - muzzle
    if delta.Magnitude < .1 then return false end
    local direction = delta.Unit
    local aim = direction
    if name == "FireSniper" and Ballistics
        and type(Ballistics.launch) == "function" then
        local ok, computed = pcall(Ballistics.launch, muzzle, point, speed, arc)
        if ok and typeof(computed) == "Vector3" and computed.Magnitude > .5 then
            aim = computed.Unit
        end
    end

    if name == "FireShotgun" then
        a[2] = direction
        for i = 3, n do
            if typeof(a[i]) == "Vector3" then a[i] = direction end
        end
    else
        a[2] = aim
        if typeof(a[4]) == "Vector3" then a[4] = direction end
        if type(a[5]) == "number" then a[5] = 0 end
    end
    -- Use the predicted impact for visual tracer instead of stale body position.
    return true, point
end

-- =====================================
-- ZERO SPREAD: MAKE A SHOT FOLLOW THE SCREEN CENTER
-- =====================================
-- RifleClient generates a random spreadDir() BEFORE FireServer,
-- so setting only the server cone (argument 5) to zero is not enough.
-- We also replace the already-spread direction (argument 2) with a
-- direction from the gun muzzle to the precise center-camera ray.
-- No Raycast hook, no ammo/recoil/tracer cancellation.
local function applyZeroSpread(name, a, n)
    local muzzle = a[1]
    if typeof(muzzle) ~= "Vector3" or typeof(a[2]) ~= "Vector3" then
        return false
    end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local center = cam.ViewportSize * 0.5
    local centerRay = cam:ViewportPointToRay(center.X, center.Y)
    local aimPoint = centerRay.Origin + centerRay.Direction * 500
    local diff = aimPoint - muzzle
    if diff.Magnitude < 0.001 then return false end
    local corrected = diff.Unit

    -- Match the original RifleClient remote argument format.
    a[2] = corrected
    if name == "FireShotgun" then
        -- All pellet direction vectors are aligned; keep other types intact.
        for i = 3, n do
            if typeof(a[i]) == "Vector3" then
                a[i] = corrected
            end
        end
    else
        -- a[4] = center look vector; a[5] = random cone/spread.
        if typeof(a[4]) == "Vector3" then
            a[4] = centerRay.Direction
        end
        if type(a[5]) == "number" then
            a[5] = 0
        end
    end
    return true
end

-- Visual-only tracer adjustment, preserving the original Tracers implementation.
local Tracers, oldTracerFire, tracerWrapper
pcall(function()
    local module = Voxel:FindFirstChild("Tracers")
    if not module then return end
    local result = require(module)
    if type(result) ~= "table" or type(result.fire) ~= "function" then return end
    Tracers, oldTracerFire = result, result.fire
    tracerWrapper = function(from, to, ...)
        if S.running and S.silent and CFG.visualTracers and S.visualShot
            and typeof(from) == "Vector3" and typeof(to) == "Vector3" then
            local shot = S.visualShot
            if os.clock() - shot.time <= 0.4
                and (from - shot.muzzle).Magnitude < 25 then
                to = shot.position
                S.visualShot = nil
                S.visuals += 1
            end
        end
        return oldTracerFire(from, to, ...)
    end
    Tracers.fire = tracerWrapper
    S.tracerReady = Tracers.fire == tracerWrapper
end)

