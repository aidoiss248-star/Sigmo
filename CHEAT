local function slider(parent,y,name,min,max,value,fn)
    local row=make("Frame",{Parent=parent,Position=UDim2.fromOffset(15,y),
        Size=UDim2.new(1,-30,0,68),BackgroundColor3=Color3.fromRGB(22,23,25),
        BorderSizePixel=0})
