-- =====================================
-- FIRE HOOK: SAME SINGLE REMOTE INTERCEPTION AS WORKING V8
-- =====================================
local oldNamecall
local function intercept(self,...)
    if not S.running or not (S.silent or S.noRecoil) then
        return oldNamecall(self,...)
    end
    if getnamecallmethod() ~= "FireServer" then return oldNamecall(self,...) end
    local name=FIRE[self]
    if not name then return oldNamecall(self,...) end
    S.shots+=1
    S.visualShot=nil
    local args=table.pack(...)

    -- Silent Aim still has priority when a real target was acquired.
    local rewritten, visualPoint = false, nil
    if S.silent then
        local ok, changed, targetPoint = pcall(rewrite,name,args,args.n)
        if ok and changed then
            rewritten, visualPoint = true, targetPoint
            S.modified += 1
            if S.tracerReady and typeof(visualPoint)=="Vector3"
                and typeof(args[1])=="Vector3" then
                S.visualShot={muzzle=args[1],position=visualPoint,time=os.clock()}
            end
        elseif not ok then
            S.errors += 1
            warn("[RAI V10] Silent Aim rewrite failed:",changed)
        end
    end

    if S.noRecoil then
        if rewritten then
            -- Silent Aim already replaced directions. Just neutralize
            -- the cone value for weapons with the RifleClient signature.
            if name ~= "FireShotgun" and type(args[5]) == "number" then
                args[5] = 0
            end
            S.straightened += 1
        else
            -- Fires straight at the crosshair even with Silent Aim OFF,
            -- or after a Hit Chance miss / no target.
            local ok, changed = pcall(applyZeroSpread,name,args,args.n)
            if ok and changed then
                S.straightened += 1
            elseif not ok then
                S.errors += 1
                warn("[RAI V10] Zero Spread rewrite failed:",changed)
            end
        end
    end

    -- Preserve the native shooting call, ammo, sounds and effects.
    return oldNamecall(self,table.unpack(args,1,args.n))
end
if type(hookmetamethod)=="function" and type(getnamecallmethod)=="function" then
    local callback=type(newcclosure)=="function" and newcclosure(intercept) or intercept
    local ok,previous=pcall(hookmetamethod,game,"__namecall",callback)
    if ok and type(previous)=="function" then
        oldNamecall=previous
        S.hookReady=true
    else
        warn("[RAI V10] Hook failed:",previous)
    end
end

